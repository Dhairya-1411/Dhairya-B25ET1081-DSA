#include <stdio.h>
void swap(int *a, int *b)
{
    int temp;
    temp = *a;
    *a = *b;
    *b = temp;
}
int main()
{
    int array[5];
    int i, j;
    printf("Enter Array Elements:\n");
    for(i = 0; i < 5; i++)
    {
        scanf("%d", &array[i]);
    }
    for(i = 0; i < 4; i++)
    {
        for(j = 0; j < 4-i; j++)
        {
            if(array[j] > array[j + 1])
            {
                swap(&array[j], &array[j + 1]);
            }
        }
    }
    printf("Sorted Array:\n");
    for(i=0; i<5;i++)
    {
        printf("%d ", array[i]);
    }


    return 0;
}
